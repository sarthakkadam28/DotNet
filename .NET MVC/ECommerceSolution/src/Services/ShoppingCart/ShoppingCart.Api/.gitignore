####################################
# OS / System files
####################################
.DS_Store
Thumbs.db
Desktop.ini

####################################
# Visual Studio / VS Code
####################################
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

####################################
# Build output
####################################
**/bin/
**/obj/
**/out/
**/publish/

####################################
# .NET runtime artifacts
####################################
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json

####################################
# Logs
####################################
*.log
logs/
**/logs/

####################################
# AppSettings (environment specific)
####################################
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Staging.json
**/appsettings.Production.json

# Keep base config
!**/appsettings.json

####################################
# Secrets
####################################
**/secrets.json
**/.env
**/*.env

####################################
# NuGet
####################################
*.nupkg
*.snupkg
.nuget/packages/
.nuget/guid/

####################################
# YARP (API Gateway)
####################################
# Generated or environment-specific YARP configs
**/yarp.*.json

# If you keep proxy config in appsettings.json, this is safe to commit
# ReverseProxy section is fine

####################################
# Docker (optional but common)
####################################
**/docker-compose.override.yml

####################################
# Database files
####################################
*.mdf
*.ldf
*.sqlite
*.db

####################################
# Test results
####################################
TestResults/
*.trx
*.coverage

####################################
# Node (if any frontend tooling)
####################################
node_modules/
npm-debug.log*
yarn-error.log*

####################################
# Temporary / backup files
####################################
*.tmp
*.bak
*.swp
